@echo off
REM CutMind one-shot setup for Windows. Safe to re-run.
setlocal
cd /d "%~dp0"

where python >nul 2>nul || (echo [!] Python 3.11+ not found. Install: winget install Python.Python.3.13 & exit /b 1)
where node >nul 2>nul || (echo [!] Node.js not found. Install: winget install OpenJS.NodeJS.LTS & exit /b 1)

where ffmpeg >nul 2>nul
if errorlevel 1 (
  echo [*] FFmpeg not on PATH - installing with winget ^(user scope^)...
  winget install --id Gyan.FFmpeg.Essentials -e --accept-source-agreements --accept-package-agreements --silent
  echo     If ffmpeg is still not found, open a NEW terminal ^(PATH refresh^). The backend also auto-finds winget installs.
)

echo [*] Python virtualenv + backend packages
if not exist backend\.venv python -m venv backend\.venv
backend\.venv\Scripts\python.exe -m pip install --upgrade pip -q
backend\.venv\Scripts\python.exe -m pip install -r backend\requirements-dev.txt -q || exit /b 1

echo [*] Royalty-free music beds (generated by FFmpeg)
pushd backend
.venv\Scripts\python.exe -m cutmind.media_gen --music assets\music
popd

echo [*] Mobile app packages
pushd mobile
call npm install || exit /b 1
popd

echo [*] Downloading models: Qwen2.5-1.5B-Instruct ONNX ^(~1.8 GB^) + faster-whisper tiny
pushd backend
set PLANNER_MODE=local
.venv\Scripts\python.exe -m cutmind.prefetch
popd
echo.
echo Done. Start everything with:  run-all.bat
